{
  "description": "dev-standard-kit completion gate",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && npm run harness:verify -- --hook",
            "timeout": 1200,
            "statusMessage": "Running repository harness verification"
          }
        ]
      }
    ]
  }
}
