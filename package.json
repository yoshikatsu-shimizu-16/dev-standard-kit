{
  "name": "dev-standard-kit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @dev-standard/frontend",
    "typecheck": "npm run typecheck --workspace @dev-standard/frontend",
    "lint": "npm run lint --workspace @dev-standard/frontend",
    "format": "npm run format --workspace @dev-standard/frontend",
    "format:check": "npm run format:check --workspace @dev-standard/frontend",
    "test": "npm run test --workspace @dev-standard/frontend",
    "test:e2e": "npm run test:e2e --workspace @dev-standard/frontend",
    "storybook": "npm run storybook --workspace @dev-standard/frontend",
    "build-storybook": "npm run build-storybook --workspace @dev-standard/frontend",
    "build": "npm run build --workspace @dev-standard/frontend",
    "harness:verify": "bash .agents/scripts/harness-verify.sh"
  }
}
